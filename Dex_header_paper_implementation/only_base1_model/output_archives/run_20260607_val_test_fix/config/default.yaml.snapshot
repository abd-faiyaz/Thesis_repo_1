# Base Model 1 (MLP(H)) — default configuration
# Paths are relative to only_base1_model/ unless absolute.

paths:
  apk_root: data/apks              # remote: point to 50k APK directory
  processed_dir: artifacts/processed
  checkpoint_dir: artifacts/checkpoints
  latest_checkpoint: artifacts/checkpoints/latest_checkpoint.pth
  failed_apks_log: artifacts/failed_apks.log
  normalization_stats: artifacts/normalization.json
  splits_dir: artifacts/splits

preprocessing:
  multidex:
    mode: sum                      # sum | mean | primary_only | concat
    dex_pattern: "^classes(\\d*)\\.dex$"
    max_dex: 3                     # used only when mode: concat
  # dex_entry_name: classes.dex    # deprecated; use multidex.mode: primary_only for ablation
  cache_version: 2                 # v1=primary-only artifacts; v2=multidex aggregation
  output_format: pt                # pt | npy
  aggregate_filename: dex_header_features.pt
  # Labels: parent folder name (benign/ vs malware/) or explicit CSV manifest
  label_mode: parent_folder        # parent_folder | csv
  labels_csv: null                  # e.g. data/labels.csv when label_mode=csv
  benign_names: [benign, goodware, clean, good, "0"]
  malicious_names: [malware, malicious, virus, bad, "1"]
  # Temporal protocol: train on train_years, val holdout from train_years, test on test_years
  split_mode: temporal_year       # temporal_year | stratified_random
  train_years: [2020, 2021]
  test_years: [2022, 2023]
  val_fraction: 0.1               # stratified holdout from train_years (early stopping / best.pt)

data:
  batch_size: 16                  # paper
  num_workers: 4
  pin_memory: true
  random_seed: 42

model:
  hidden_dim: 128                  # tune after feature dim is known (Phase 2)

training:
  loss: BCELoss
  optimizer: SGD
  learning_rate: 0.005
  momentum: 0.9
  lr_decay_factor: 0.5
  lr_scheduler: StepLR             # StepLR | ExponentialLR
  lr_step_size: 10                 # epochs between LR *= 0.5 (StepLR only)
  epochs: 50
  checkpoint_every_epoch: true
  device: cuda                     # fallback to cpu if unavailable

evaluation:
  threshold: 0.5
  metrics:
    - accuracy
    - f1
    - roc_auc
