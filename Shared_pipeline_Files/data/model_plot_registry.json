      "comment": "Strong AUC; heaviest parse cost",
      "domain": "manifest_xgb",
      "include_in_csv": true,
      "include_in_plots": true,
      "offline_metrics_from": "metrics",
      "split_note_key": "temporal_holdout_764",
      "test_results_candidates": [
        "legacy_models/artifacts/manifest_xgb/metrics/test_results.json"
      ],
      "evaluate": {
        "cwd": ".",
        "script": "legacy_models/run_thesis_eval.sh",
        "env": { "SPLIT": "test" },
        "note": "Runs manifest_xgb and bytecnn; idempotent for manifest_xgb only when bytecnn skipped via separate legacy call"
      }
    },
    {
      "model_id": "bytecnn",
      "method": "1D-CNN",
      "features": "Last 1024 APK bytes",
