{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cascade_policy.schema.json",
  "title": "VigiDroid cascade policy",
  "type": "object",
  "required": ["policy_name", "enabled", "tiers"],
  "properties": {
    "policy_name": { "type": "string" },
    "enabled": { "type": "boolean" },
    "tier3_pattern_model": { "type": "string" },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tier", "models", "t_low", "t_high"],
        "properties": {
          "tier": { "type": "integer", "minimum": 1 },
          "models": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "aggregation": { "type": "string" },
          "t_low": { "type": "number", "minimum": 0, "maximum": 1 },
          "t_high": { "type": "number", "minimum": 0, "maximum": 1 },
          "conservative_malware_or": { "type": "boolean" },
          "mlp_header_fallback": { "type": "boolean" },
          "final": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "model_weights": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "fusion_weights": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "calibration": {
      "type": "object",
      "properties": {
        "n_aligned_apks": { "type": "integer", "minimum": 0 },
        "alignment_key": { "type": "string" },
        "targets": {
          "type": "object",
          "properties": {
            "target_false_omission_rate": { "type": "number" },
            "target_false_alarm_at_thigh": { "type": "number" }
          }
        },
        "tiers": { "type": "array" },
        "cumulative_exit": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
